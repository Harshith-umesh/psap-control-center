# PASP Control Center Environment Configuration

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Role-based accounts (both are required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-admin-password
USER_USERNAME=user
USER_PASSWORD=change-user-password

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./data/pasp_control_center.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pasp_control_center

# Kubeconfig Storage
KUBECONFIG_STORAGE_PATH=./kubeconfigs

# Hearth / Fournos management cluster
HEARTH_ENABLED=true
HEARTH_NAMESPACE=hearth
# HEARTH_KUBECONFIG_PATH=/absolute/path/to/management.kubeconfig

# Billing CSV Storage
BILLING_CSV_STORAGE_PATH=./billing_csvs

# MLFlow Integration (optional)
MLFLOW_BASE_URL=https://your-mlflow-server.example.com

# API Settings
API_V1_PREFIX=/api/v1

# Logging Configuration (optional - defaults to INFO)
# Options: ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO
